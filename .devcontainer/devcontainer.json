{
  "name": "ShopFast Terraform Workshop",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "features": {
    "ghcr.io/devcontainers/features/terraform:1": {},
    "ghcr.io/devcontainers/features/aws-cli:1": {},
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    "ghcr.io/devcontainers/features/python:1": {}
  },
  "containerEnv": {
    "AWS_ACCESS_KEY_ID": "test",
    "AWS_SECRET_ACCESS_KEY": "test",
    "AWS_REGION": "us-east-1",
    "AWS_ENDPOINT_URL": "http://localhost:4566"
  },
  "forwardPorts": [4500, 4501, 4566],
  "portsAttributes": {
    "4500": { "label": "Floci UI", "onAutoForward": "openBrowser" },
    "4501": { "label": "Floci UI API", "onAutoForward": "silent" },
    "4566": { "label": "Floci AWS endpoint", "onAutoForward": "silent" }
  },
  "postCreateCommand": "bash .devcontainer/install-tools.sh",
  "postStartCommand": "bash .devcontainer/start-emulator.sh",
  "customizations": {
    "vscode": {
      "extensions": ["hashicorp.terraform"]
    }
  }
}
